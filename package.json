{
	"name": "ari",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:private": "prettier --check --ignore-path .prettierignore private/web && eslint --config private/web/eslint.config.js private/web",
		"format": "prettier --write .",
		"test": "bun test src",
		"test:private": "svelte-kit sync && bun test private/web",
		"db:up": "docker compose up -d --wait db",
		"db:deploy": "prisma migrate deploy",
		"db:migrate": "prisma migrate dev",
		"db:generate": "prisma generate",
		"db:seed": "bun run prisma/seed.ts",
		"image:public": "docker build -t ari-web:public .",
		"image:private": "docker build --build-arg edition=private --build-context privateweb=private/web -t ari-web:private ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"linkedom": "^0.18.12",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prisma": "^7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@sentry/sveltekit": "^10.66.0",
		"chart.js": "^4.5.1",
		"marked": "^18.0.9"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
